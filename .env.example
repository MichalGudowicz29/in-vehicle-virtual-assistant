# Wzór konfiguracji. Aktywny wybór obu modeli zmieniaj wyłącznie w .env.
# Lokalny model Ollama z obsługą tool calling; musi być wcześniej pobrany.
OLLAMA_MODEL=qwen3.5:2b

# vosk, whisper-small, whisper-medium, whisper-large, whisper-large-v3-turbo-q5_0
ASR_MODEL=vosk

# Opcjonalne ustawienia generacji; puste = domyślne modelu/serwera (nieznane aplikacji).
# Ustawiaj dopiero po diagnozie done_reason i konfiguracji Ollamy.
OLLAMA_NUM_CTX=
OLLAMA_NUM_PREDICT=
# true / false; puste nie zmienia domyślnego trybu thinking modelu.
OLLAMA_REASONING=
